{
  "expo": {
    "name": "client",
    "slug": "client",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "enabled": true,
      "url": "http://192.168.0.3:3000/api/updates/manifest",
      "requestHeaders": {
        "expo-channel-name": "development"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.durun-onout.client"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.durun_onout.client"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d8a690b9-2a40-4d9c-b8ab-dee5b91f4ee7"
      },
      "cloudPush": {
        "checkUpdateStatusUrl": "http://192.168.0.3:3000/api/updates/status"
      }
    },
    "owner": "durun_onout"
  }
}
